# .streamlit/secrets.toml.example
#
# Template for Streamlit Community Cloud secrets.
# Copy these key=value pairs into the "Secrets" textarea on the Streamlit Cloud
# dashboard (App settings → Secrets). Do NOT commit a real secrets.toml here.
#
# Root-level TOML keys are also exposed as environment variables at runtime,
# so config.py's os.environ.get() calls remain fully compatible — no code
# changes needed.

# ── Required ────────────────────────────────────────────────────────────────

# NASA FIRMS Area API map key. Register free at:
# https://firms.modaps.eosdis.nasa.gov/api/area/
FIRMS_MAP_KEY = "your_firms_map_key_here"

# IBM watsonx.ai credentials (IBM Cloud IAM API key + project ID)
WATSONX_API_KEY    = "your_watsonx_api_key_here"
WATSONX_PROJECT_ID = "your_project_id_here"

# ── Optional overrides ───────────────────────────────────────────────────────

# watsonx.ai service URL (default: https://us-south.ml.cloud.ibm.com)
# WATSONX_URL = "https://us-south.ml.cloud.ibm.com"

# Override the default Granite generator model
# WATSONX_MODEL_ID = "ibm/granite-4-h-small"

# Override the default critic/guardrail model
# WATSONX_GUARDIAN_MODEL_ID = "meta-llama/llama-3-3-70b-instruct"
