# NASA FIRMS Map Key
# Register at: https://firms.modaps.eosdis.nasa.gov/api/area/
FIRMS_MAP_KEY=your_firms_map_key_here

# IBM watsonx.ai credentials
# Obtain from: https://cloud.ibm.com/iam/apikeys
WATSONX_API_KEY=your_watsonx_api_key_here

# watsonx.ai project ID (found in your watsonx.ai project settings)
WATSONX_PROJECT_ID=your_project_id_here

# watsonx.ai service URL (e.g. https://us-south.ml.cloud.ibm.com)
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# Optional: override the default Granite generator model ID
# Default: ibm/granite-4-h-small
# WATSONX_MODEL_ID=ibm/granite-4-h-small

# Critic/guardrail model (Task 6 AI Guardrails).
# Default: meta-llama/llama-3-3-70b-instruct (available in free-plan deployments).
# Set to ibm/granite-guardian-3-8b when that model becomes available in your instance.
# WATSONX_GUARDIAN_MODEL_ID=meta-llama/llama-3-3-70b-instruct

# Debug: set to 1 to inject a fabricated spread_index into summarize() so you
# can test the full generator→critic→correction pipeline against the live API.
# FORCE_FABRICATED_TEST=1

# ---------------------------------------------------------------------------
# Email alerts — EXTREME risk notifications via SMTP
# ---------------------------------------------------------------------------
# Set ALERT_EMAIL_ENABLED=true to activate; all other keys must also be set.
# Default transport: Gmail SMTP (smtp.gmail.com:587, STARTTLS).
# Required: generate a 16-char app password at Google Account → Security →
# App passwords (2FA must be enabled on the Gmail account).
# No new service signup; no cost; uses Python stdlib smtplib only.

# ALERT_EMAIL_ENABLED=true

# SMTP server — leave at default to use Gmail.
# ALERT_SMTP_HOST=smtp.gmail.com
# ALERT_SMTP_PORT=587

# Gmail account that sends the alert emails.
# ALERT_SMTP_USER=you@gmail.com

# 16-char Gmail app password (NOT your regular Google password).
# ALERT_SMTP_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Recipient address (can be the same as ALERT_SMTP_USER, or a team address).
# ALERT_EMAIL_TO=recipient@example.com
